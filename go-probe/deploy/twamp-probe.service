[Unit]
Description=SPI TWamp Probe (Go)
Documentation=https://github.com/akprof2000/twamp-probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/twamp-probe-go
ExecStart=/opt/twamp-probe-go/twamp-probe
Restart=always
RestartSec=5

# --- Лимиты: без них проба упирается в потолок задолго до возможностей машины ---
#
# Один идущий замер стоит ядру ДВУХ учётных единиц: процесса зонда (twping,
# python -m twampy, ping) и потока пробы, который ждёт его завершения. Замер:
# на 1500 запущенных зондов у пробы 1523 потока.
#
# Штатные для CentOS/RHEL 4096 (см. /etc/security/limits.d/20-nproc.conf) дают
# границу ровно в 2048 одновременных замеров. За ней ядро отказывает в создании
# потока, а для Go это fatal error — служба умирает целиком. Проба сама снизит
# свой потолок, чтобы туда не дойти, но работать будет вполсилы.
#
# 65535 хватает примерно на 32 000 одновременных замеров внешними утилитами.
# Своего потолка проба не навязывает: если этого мало, поднимайте и дальше —
# она предупредит при старте, что лимит тесен, но настройку не изменит.
LimitNPROC=65535

# Дескрипторы: на каждый замер приходится около трёх (два канала вывода зонда
# и ожидание процесса), плюс сокеты сервера и файлы журнала.
LimitNOFILE=1048576

# Размер стека потока — по умолчанию 8 МБ виртуальной памяти на поток.
# При тысячах потоков адресное пространство расходуется зря.
LimitSTACK=1048576

# Проба переживает нехватку памяти сама (снижает число запусков), поэтому
# убийце OOM лучше выбрать другую жертву, а не гасить всю службу.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
