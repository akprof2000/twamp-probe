    "Console": true,
    "Compress": true
  },
  "Auth": {
    "ApiKey": ""
  },
  "ping": {
    "name": "ping",
    "default": "-c 2"
  },
  "twamp": {
    "name": "./twping",
    "default": "",
    "embedded": true
  },
  "twampy": {
    "name": "python3",
    "default": "",
    "embedded": true
  }
