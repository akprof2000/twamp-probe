{
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8443",
  "Probe": {
    "MaxParallel": 0,
    "MaxPendingResults": 100000,
    "PersistIntervalSec": 5,
    "ServerTimeoutHours": 24
  },
  "Auth": {
    "ApiKey": ""
  },
  "ping": {
    "name": "ping",
    "default": ""
  },
  "twamp": {
    "name": "./twping",
    "default": ""
  },
  "twampy": {
    "name": "python3",
    "default": "",
    "embedded": false
  },
  "NLog": {
    "throwConfigExceptions": true,
    "internalLogLevel": "Off",
    "extensions": [
      {
        "assembly": "NLog.Web.AspNetCore"
      }
    ],
    "variables": {
      "msg": "${message} ${onexception:${newline}${exception:format=type,message,method:maxInnerExceptionLevel=5:innerFormat=type,message,method:separator=${newline}}}",
      "text": "${replace-newlines:replacement=\\n\\t:${msg}}",
      "line": "${date:format=yyyy-MM-dd HH\\:mm\\:ss.fff} ${level:uppercase=true:padding=-5} [${logger:shortName=true}] ${var:text}"
    },
    "targets": {
      "console": {
        "type": "LimitingWrapper",
        "interval": "00:00:01",
        "messageLimit": 100,
        "target": {
          "type": "ColoredConsole",
          "layout": "${var:line}"
        }
      },
      "file": {
        "type": "AsyncWrapper",
        "queueLimit": 10000,
        "overflowAction": "Discard",
        "target": {
          "type": "File",
          "fileName": "${basedir}/log/Probe.log",
          "archiveFileName": "${basedir}/log/Probe.{#}.log",
          "layout": "${var:line}",
          "archiveAboveSize": 10485760,
          "maxArchiveFiles": 20,
          "archiveNumbering": "Rolling",
          "keepFileOpen": true
        }
      }
    },
    "rules": [
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "console,file"
      }
    ]
  }
}
