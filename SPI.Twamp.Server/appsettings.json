{
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:9000",
  "Probe": {
    "HttpTimeoutSec": 60,
    "ReconcileIntervalSec": 30,
    "CleanupWaitHours": 24
  },
  "Database": {
    "CheckpointMin": 5
  },
  "ClickHouse": {
    "Enabled": false,
    "Url": "http://localhost:8123",
    "Database": "twamp",
    "Table": "results",
    "User": "default",
    "Password": "",
    "BatchRows": 100000,
    "FlushMinutes": 10,
    "MaxSegments": 16,
    "SpoolPath": "spool",
    "RetrySeconds": 30,
    "TimeoutSec": 300
  },
  "Auth": {
    "ApiKey": ""
  },
  "Retention": {
    "IntervalMin": 60,
    "RawDays": 14,
    "StatsDays": 90,
    "DeletedTaskDays": 7
  },
  "NLog": {
    "throwConfigExceptions": true,
    "internalLogLevel": "Off",
    "extensions": [
      {
        "assembly": "NLog.Web.AspNetCore"
      }
    ],
    "variables": {
      "text": "${replace-newlines:replacement= ⏎ :${message}}${onexception:  →  ${exception:format=type,message,method:maxInnerExceptionLevel=5:innerFormat=type,message,method:separator=  →  }}",
      "line": "${date:format=yyyy-MM-dd HH\\:mm\\:ss.fff} ${level:uppercase=true:padding=-5} [${logger:shortName=true}] ${var:text}"
    },
    "targets": {
      "console": {
        "type": "LimitingWrapper",
        "interval": "00:00:01",
        "messageLimit": 100,
        "target": {
          "type": "ColoredConsole",
          "layout": "${var:line}"
        }
      },
      "file": {
        "type": "AsyncWrapper",
        "queueLimit": 10000,
        "overflowAction": "Discard",
        "target": {
          "type": "File",
          "fileName": "${basedir}/log/BackEnd.log",
          "archiveFileName": "${basedir}/log/BackEnd.{#}.log",
          "layout": "${var:line}",
          "archiveAboveSize": 10485760,
          "maxArchiveFiles": 20,
          "archiveNumbering": "Rolling",
          "keepFileOpen": true
        }
      }
    },
    "rules": [
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "console,file"
      }
    ]
  }
}
