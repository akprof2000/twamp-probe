[Unit]
Description=SPI TWamp Configurator
Documentation=https://github.com/akprof2000/twamp-probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=twamp
Group=twamp
WorkingDirectory=/opt/twamp-server
ExecStart=/opt/twamp-server/SPI.Twamp.Server
Restart=always
RestartSec=5

# Конфигуратор обслуживает веб-интерфейс, LiteDB и сверку расписаний.
LimitNOFILE=1048576

# Даём завершить текущие операции с LiteDB.
TimeoutStopSec=60
KillSignal=SIGTERM

# Каталог рабочий, но системные пути сервер не трогает.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
