{
  "Urls": "http://localhost:9001",
  "Collector": { "Id": "default", "Machine": "" },
  "HighAvailability": { "Enabled": false, "Keeper": "", "Digest": "", "Root": "/twamp-ha", "SessionTimeoutMs": 15000, "StandbyDelaySeconds": 6 },
  "Probe": { "HttpTimeoutSec": 60 },
  "Auth": { "ApiKey": "" },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "NLog": {
    "variables": { "line": "${longdate} ${level:uppercase=true} [${logger}] ${message} ${exception:format=message}" },
    "targets": {
      "console": { "type": "Console", "layout": "${var:line}" },
      "file": {
        "type": "File",
        "fileName": "${basedir}/log/Collector.log",
        "archiveAboveSize": 10485760,
        "maxArchiveFiles": 5,
        "layout": "${var:line}"
      }
    },
    "rules": [{ "logger": "*", "minLevel": "Info", "writeTo": "console,file" }]
  },
  "ClickHouse": {
    "Enabled": true,
    "Url": "http://localhost:8123",
    "Urls": [],
    "FailoverRetrySeconds": 30,
    "Database": "twamp",
    "Table": "results",
    "User": "default",
    "Password": "",
    "SpoolPath": "spool",
    "RetrySeconds": 5,
    "TimeoutSec": 300
  }
}
