<clickhouse>
  <listen_host>0.0.0.0</listen_host>
  <interserver_http_host from_env="CH_HOST"/>
  <macros><shard>01</shard><replica from_env="CH_REPLICA"/></macros>
  <zookeeper>
    <node><host from_env="CH_HOST_1"/><port>9181</port></node>
    <node><host from_env="CH_HOST_2"/><port>9181</port></node>
    <node><host from_env="CH_HOST_3"/><port>9181</port></node>
  </zookeeper>
  <remote_servers><twamp><shard><internal_replication>true</internal_replication>
    <replica><host from_env="CH_HOST_1"/><port>9000</port></replica>
    <replica><host from_env="CH_HOST_2"/><port>9000</port></replica>
    <replica><host from_env="CH_HOST_3"/><port>9000</port></replica>
  </shard></twamp></remote_servers>
  <keeper_server>
    <tcp_port>9181</tcp_port><server_id from_env="CH_NODE_ID"/>
    <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
    <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
    <raft_configuration>
      <server><id>1</id><hostname from_env="CH_HOST_1"/><port>9234</port></server>
      <server><id>2</id><hostname from_env="CH_HOST_2"/><port>9234</port></server>
      <server><id>3</id><hostname from_env="CH_HOST_3"/><port>9234</port></server>
    </raft_configuration>
  </keeper_server>
</clickhouse>
