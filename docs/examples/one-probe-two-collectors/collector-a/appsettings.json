{
  "Urls": "http://192.0.2.21:9001",
  "Collector": {
    "Id": "collector-a",
    "UseLegacyCatalog": false
  },
  "HighAvailability": {
    "Enabled": false
  },
  "Probe": {
    "HttpTimeoutSec": 60
  },
  "Auth": {
    "ApiKey": "REPLACE_WITH_SHARED_API_KEY"
  },
  "ClickHouse": {
    "Enabled": true,
    "Url": "http://192.0.2.30:8123",
    "Urls": [],
    "FailoverRetrySeconds": 30,
    "Database": "twamp",
    "Table": "results",
    "User": "twamp_writer",
    "Password": "REPLACE_WITH_CLICKHOUSE_PASSWORD",
    "SpoolPath": "spool",
    "RetrySeconds": 5,
    "TimeoutSec": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "NLog": {
    "variables": {
      "line": "${longdate} ${level:uppercase=true} [${logger}] ${message} ${exception:format=message}"
    },
    "targets": {
      "console": {
        "type": "Console",
        "layout": "${var:line}"
      },
      "file": {
        "type": "File",
        "fileName": "${basedir}/log/Collector.log",
        "archiveAboveSize": 10485760,
        "maxArchiveFiles": 5,
        "layout": "${var:line}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console,file"
      }
    ]
  }
}
